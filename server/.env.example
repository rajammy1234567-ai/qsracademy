# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/qsr_academy?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/qsr_academy
MONGODB_URI=mongodb://127.0.0.1:27017/qsr_academy

# Authentication
JWT_SECRET=qsr_academy_super_secret_production_jwt_key_2026_secure
JWT_EXPIRES_IN=2h
COOKIE_SECRET=qsr_cookie_secret_key_987654321

# Client URL (CORS allowlist)
CLIENT_URL=http://localhost:5173

# Initial Seed Credentials (for `npm run seed`)
ADMIN_SEED_NAME="QSR Academy Admin"
ADMIN_SEED_EMAIL="academyqsr@gmail.com"
ADMIN_SEED_PASSWORD="AdminQSR@2026#Secure!"

# Email Notifications (Sends alerts to academyqsr@gmail.com on any enquiry)
ADMIN_NOTIFICATION_EMAIL="academyqsr@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="academyqsr@gmail.com"
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS="your_16_character_google_app_password"
EMAIL_FROM="QSR ACADEMY Leads <academyqsr@gmail.com>"
# Web3Forms API Key for guaranteed zero-block email delivery
WEB3FORMS_ACCESS_KEY="64224096-cb27-45db-a2f0-7529eef24d6e"

